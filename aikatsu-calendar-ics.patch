+<!-- ===== [JS] 本体のメイン <script> の後ろ、</body> の直前に貼る ===== -->
+<script>
+(function(){
+  "use strict";
+
+  // .ics の配信先。ドメインはどこにも書かない。
+  // モーダルの data-feed-base（既定 "calendar/"）をページ自身のURL基準で解決するので、
+  // 本家・フォーク・独自ドメイン・ローカルサーバのいずれでもそのまま正しい先を指す。
+
+  // build_ics.py の FEEDS と対応。増やす場合は両方に足すこと。
+  var FEEDS = [
+    { slug:"aikatsu-all",         label:"すべて",       desc:"イベント・グッズ・配信・誕生日・周年をすべて含みます。" },
+    { slug:"aikatsu-nobirthday",  label:"誕生日以外",   desc:"誕生日と周年を除いた、イベント／グッズ／配信などの予定だけを購読します。" },
+    { slug:"aikatsu-event",       label:"イベント",     desc:"ライブ・上映会・POP UP SHOP などのイベントのみ。" },
+    { slug:"aikatsu-goods",       label:"グッズ",       desc:"グッズの発売日・予約開始／締切のみ。" },
+    { slug:"aikatsu-game",        label:"アンコール",   desc:"『アイカツ！アンコール』関連の予定のみ。" },
+    { slug:"aikatsu-birthday",    label:"誕生日",       desc:"キャラクターの誕生日のみ（毎年繰り返し）。" }
+  ];
+
+  var current = FEEDS[0];
+
+  var btn        = document.getElementById("subscribeBtn");
+  var modal      = document.getElementById("subModal");
+  var panel      = document.getElementById("subModalPanel");
+  var closeBtn   = document.getElementById("subModalClose");
+  var feedsWrap  = document.getElementById("subFeeds");
+  var feedDesc   = document.getElementById("subFeedDesc");
+  var urlInput   = document.getElementById("subUrlInput");
+  var copyBtn    = document.getElementById("subCopyBtn");
+  var aGoogle    = document.getElementById("subGoogle");
+  var aApple     = document.getElementById("subApple");
+  var aOutlook   = document.getElementById("subOutlook");
+  var aDownload  = document.getElementById("subDownload");
+  if(!btn || !modal) return;
+
+  var lastFocused = null;
+
+  var FEED_BASE = new URL(modal.getAttribute("data-feed-base") || "calendar/", location.href).href;
+
+  function httpsUrl(feed){ return FEED_BASE + feed.slug + ".ics"; }
+  function webcalUrl(feed){ return httpsUrl(feed).replace(/^https?:/, "webcal:"); }
+
+  function applyFeed(feed){
+    current = feed;
+    var https = httpsUrl(feed);
+    var webcal = webcalUrl(feed);
+    urlInput.value = https;
+    // Google: cid には webcal:// 形式を渡す。
+    // https:// を渡すと cid をカレンダーIDとして解釈しようとして
+    // 「カレンダーを追加できません。URL を確認してください。」で弾かれることがある。
+    // /u/0/ は付けない（ログイン中のアカウント選択をユーザーに委ねるため）。
+    aGoogle.href = "https://calendar.google.com/calendar/render?cid=" + encodeURIComponent(webcal);
+    aApple.href = webcal;
+    aOutlook.href = "https://outlook.live.com/calendar/0/addfromweb?url=" +
+      encodeURIComponent(https) + "&name=" + encodeURIComponent("アイカツ！情報カレンダー");
+    aDownload.href = https;
+    aDownload.setAttribute("download", feed.slug + ".ics");
+    feedDesc.textContent = feed.desc;
+    Array.prototype.forEach.call(feedsWrap.children, function(b){
+      b.setAttribute("aria-pressed", String(b.dataset.slug === feed.slug));
+    });
+    copyBtn.classList.remove("copied");
+    copyBtn.textContent = "コピー";
+  }
+
+  FEEDS.forEach(function(feed){
+    var b = document.createElement("button");
+    b.type = "button";
+    b.className = "sub-feed-btn";
+    b.dataset.slug = feed.slug;
+    b.textContent = feed.label;
+    b.setAttribute("aria-pressed", "false");
+    b.addEventListener("click", function(){ applyFeed(feed); });
+    feedsWrap.appendChild(b);
+  });
+  applyFeed(FEEDS[0]);
+
+  function openModal(){
+    lastFocused = document.activeElement;
+    modal.hidden = false;
+    document.body.style.overflow = "hidden";
+    closeBtn.focus();
+    document.addEventListener("keydown", onKeydown, true);
+  }
+  function closeModal(){
+    modal.hidden = true;
+    document.body.style.overflow = "";
+    document.removeEventListener("keydown", onKeydown, true);
+    if(lastFocused && lastFocused.focus) lastFocused.focus();
+  }
+  function onKeydown(e){
+    if(e.key === "Escape"){ e.preventDefault(); closeModal(); return; }
+    if(e.key !== "Tab") return;
+    var f = panel.querySelectorAll('a[href], button:not([disabled]), input, [tabindex]:not([tabindex="-1"])');
+    if(!f.length) return;
+    var first = f[0], last = f[f.length - 1];
+    if(e.shiftKey && document.activeElement === first){ e.preventDefault(); last.focus(); }
+    else if(!e.shiftKey && document.activeElement === last){ e.preventDefault(); first.focus(); }
+  }
+
+  btn.addEventListener("click", openModal);
+  closeBtn.addEventListener("click", closeModal);
+  modal.addEventListener("click", function(e){ if(e.target === modal) closeModal(); });
+
+  copyBtn.addEventListener("click", function(){
+    var text = urlInput.value;
+    function done(){
+      copyBtn.textContent = "コピーしました";
+      copyBtn.classList.add("copied");
+      setTimeout(function(){ copyBtn.textContent = "コピー"; copyBtn.classList.remove("copied"); }, 1800);
+    }
+    if(navigator.clipboard && navigator.clipboard.writeText){
+      navigator.clipboard.writeText(text).then(done, fallback);
+    } else { fallback(); }
+    function fallback(){
+      urlInput.focus();
+      urlInput.setSelectionRange(0, urlInput.value.length);
+      try{ document.execCommand("copy"); done(); }catch(e){ /* 手動選択に任せる */ }
+    }
+  });
+
+  // URLに #subscribe が付いていたら自動で開く（SNS等から誘導する用）
+  if(location.hash === "#subscribe") openModal();
+})();
+</script>
